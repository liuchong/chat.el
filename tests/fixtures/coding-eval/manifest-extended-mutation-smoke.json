{
  "schemaVersion": 1,
  "taskTimeoutSeconds": 240,
  "corpusId": "coding-extended-mutation-smoke-v1",
  "description": "One failing-test mutation task per extended language for bounded exact-model smoke campaigns.",
  "requiredExecutables": [
    "zig",
    "lein",
    "java",
    "javac",
    "node",
    "tsc",
    "clang",
    "clang++",
    "sqlite3"
  ],
  "preflightChecks": [
    {
      "name": "extended-fixture-offline-gate",
      "command": [
        "sh",
        "verify-extended-fixtures.sh"
      ],
      "timeoutSeconds": 240
    }
  ],
  "tasks": [
    {
      "id": "zig-failing-test",
      "revision": 1,
      "category": "failing-test-fix",
      "language": "zig",
      "description": "Repair an activity-state regression.",
      "fixtureId": "zig-sample-v1",
      "fixture": "zig",
      "prompt": "The active test fails. Fix the implementation, keeping the test unchanged.",
      "allowedPaths": [
        "sample.zig"
      ],
      "generatedPaths": [
        ".zig-cache",
        "zig-out"
      ],
      "judges": [
        {
          "type": "command",
          "name": "active-tests",
          "command": [
            "sh",
            "test-one",
            "active"
          ],
          "expectedExit": 0
        }
      ]
    },
